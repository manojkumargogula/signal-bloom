{
  "name": "signal-bloom",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run --project engine",
    "gen": "node scripts/gen-lastmod.mjs && node scripts/gen-icons.mjs",
    "prebuild": "pnpm gen",
    "contrast": "node scripts/check-contrast.mjs",
    "postbuild": "node scripts/stamp-sw.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.14.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.15.1",
  "license": "MIT",
  "description": "A typing game that plays like an arcade shooter, with real typing analysis. No signup, no backend.",
  "homepage": "https://manojkumargogula.github.io/signal-bloom/",
  "repository": {
    "type": "git",
    "url": "https://github.com/manojkumargogula/signal-bloom.git"
  }
}
